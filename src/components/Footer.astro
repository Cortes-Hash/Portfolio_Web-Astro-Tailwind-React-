---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="footer-base" role="contentinfo">
  <div class="footer-inner">

    <div class="footer-logo" aria-label="Alejandro Cortés">
      <span class="logo-lt">&lt;</span>
      <span class="logo-name">AlejandroC</span>
      <span class="logo-lt">&nbsp;/&gt;</span>
    </div>

    <p class="footer-made">
      <span class="i18n-es">Hecho con ❤️ por <strong>Alejandro Cortés</strong></span>
      <span class="i18n-en">Made with ❤️ by <strong>Alejandro Cortés</strong></span>
    </p>

    <div class="footer-links">
      <a
        href="https://www.linkedin.com/in/alejandro-cortes-diaz-2b7a75271/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social"
        aria-label="LinkedIn"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a
        href="https://github.com/Cortes-Hash"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
      <a
        href="mailto:cortesdiaz905@gmail.com"
        class="footer-social"
        aria-label="Email"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        Email
      </a>
    </div>

    <p class="footer-rights">
      © {year} Alejandro Cortés.
      <span class="i18n-es"> Todos los derechos reservados.</span>
      <span class="i18n-en"> All rights reserved.</span>
    </p>

  </div>
</footer>

<style>
  .footer-base {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: 2.5rem 0 2rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-logo {
    font-family: 'Inter', monospace;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .logo-lt { color: var(--accent); }

  .footer-made {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  .footer-made strong {
    color: var(--text-primary);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.25s;
    padding: 0.3rem 0.5rem;
    border-radius: 0.35rem;
  }

  .footer-social:hover { color: var(--accent); }

  .footer-rights {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin: 0;
    opacity: 0.7;
  }
</style>
